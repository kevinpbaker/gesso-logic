{
  "name": "gessologic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/bench.ts",
    "phase0:sim": "node scripts/phase0-sim.ts",
    "proof": "node scripts/proof.ts",
    "speed": "node --import ./scripts/lib/extensionless.mjs scripts/speed.ts",
    "asm": "node --import ./scripts/lib/extensionless.mjs scripts/asm.ts",
    "generate": "node --import ./scripts/lib/extensionless.mjs scripts/generate.ts",
    "lockstep": "node --import ./scripts/lib/extensionless.mjs scripts/lockstep.ts",
    "pong": "node --import ./scripts/lib/extensionless.mjs scripts/pong.ts"
  },
  "dependencies": {
    "gesso-components": "^0.6.6",
    "gesso-core": "^0.6.6",
    "gesso-framework": "^0.6.6",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "gesso-devtools": "^0.6.6",
    "gesso-testing": "^0.6.6",
    "gesso-vite-plugin": "^0.6.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
